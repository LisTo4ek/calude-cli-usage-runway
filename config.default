# usage-runway settings.
# Defaults live in the plugin's config.default; override any of them in
# ~/.claude/usage-runway/config (created by /usage-runway:setup).

# Forecast: a limit turns yellow (and alerts once) when it is projected to end
# above this % at reset. Red when it is projected to hit 100% before reset.
WARN_PCT=80

# Burn-rate lookback windows, seconds. The forecast blends the pace over this
# lookback with the average pace since the window started.
LOOKBACK_5H=1800
LOOKBACK_7D=21600

# Minimum sample span before the recent pace is trusted, seconds.
MIN_SPAN=300

# Window time needed before a forecast is shown (until then: "→ …"), seconds.
# For 7d this is weighted time, see below.
MIN_DATA_5H=600
MIN_DATA_7D=21600

# Weekly forecast schedule: your working days (1 = Monday ... 7 = Sunday) and
# working hours DAY_START..DAY_END (local time, 0..24). Hours outside them count
# as NIGHT_WEIGHT of a working hour, days not in WORK_DAYS as OFF_DAY_WEIGHT.
# The default (every day, all day) forecasts on plain wall-clock time.
# /usage-runway:setup can set these for you.
WORK_DAYS="1 2 3 4 5 6 7"
DAY_START=0
DAY_END=24
NIGHT_WEIGHT=0.1
OFF_DAY_WEIGHT=0.1

# Cmd (usage of the current message) turns yellow / red at these 5h %.
CMD_WARN=3
CMD_CRIT=5

# Guard: when on, tool calls are denied once 5h or 7d usage reaches GUARD_PCT,
# so Claude stops and asks you whether to continue.
GUARD=off
GUARD_PCT=95

# Desktop notification for alerts (notify-send on Linux, osascript on macOS)
# and the terminal bell.
NOTIFY=on
BELL=on

# Symbols: text printed before the status line (e.g. to tell several setups
# apart), then the projection arrow, reset, separator between segments, "hits
# 100% before reset", limit reached, and "no forecast yet". Use plain text
# (e.g. SYM_ARROW="->") if your terminal font lacks them.
SYM_PREFIX=""
SYM_ARROW="→"
SYM_RESET="↻"
SYM_SEP="·"
SYM_WARN="⚠"
SYM_FULL="⛔"
SYM_WAIT="…"
# The whole text between segments, spaces included, e.g. SEP="   " for spaces
# only or SEP=" | ". When unset it is SYM_SEP with a space on each side.
# SEP=" · "

# Background of the status line: empty for none, or a color as below (e.g.
# #303030). When set, each segment is shown as a pill padded with a space on
# each side; separators keep the terminal background.
BG=""

# Colors, saved as #rrggbb. Also accepted: rrggbb, R;G;B, a 256-color
# index (setup saves 16-255 as hex; 0-15 stay numbers, they are the terminal's
# own palette and follow its theme), dim (the terminal's faint text), or empty.
# COLOR_TEXT is the main color of every panel: any other color left empty
# shows in COLOR_TEXT, and COLOR_TEXT empty is the terminal's default text
# color. The background is BG above.
COLOR_TEXT=""           # main color: Ctx %, Ses %, Cmd % below CMD_WARN
COLOR_PREFIX=""         # SYM_PREFIX
COLOR_LABEL="#5f87d7"   # segment names: 5h, 7d, Ctx, Ses, Cmd
COLOR_MUTED="#808080"   # arrow and reset sign
COLOR_SEP="#6c6c6c"     # separator between segments
COLOR_FAINT="#8a8a8a"   # time until reset, usage before a forecast exists
COLOR_GREEN="#5faf5f"   # on track
COLOR_YELLOW="#d7af5f"  # projected above WARN_PCT, Cmd at CMD_WARN
COLOR_RED="#d75f5f"     # runs out before reset, Cmd at CMD_CRIT
